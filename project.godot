; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Data Center Tycoon"
config/description="A portrait idle management game about building and operating data centers."
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.561, 0.749, 0.353, 1)
boot_splash/image="res://assets/art/store/splash_bg.png"
boot_splash/show_image=true
boot_splash/stretch_mode=1
boot_splash/use_filter=true
config/icon="res://assets/art/store/app_icon.png"

[autoload]

EventBus="*res://core/event_bus.gd"
DataRepository="*res://core/data_repository.gd"
GameClock="*res://core/game_clock.gd"
SaveManager="*res://core/save_manager.gd"
AssetCatalog="*res://core/asset_catalog.gd"
AudioService="*res://core/audio_service.gd"
Monetization="*res://core/monetization_service.gd"
Game="*res://core/game.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=804
window/size/viewport_height=1748
window/size/window_width_override=990
window/size/window_height_override=2151
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1
window/ios/hide_home_indicator=true
window/ios/hide_status_bar=true
window/ios/suppress_ui_gesture=true

[internationalization]

locale/translations=PackedStringArray("res://localization/ui.en.translation", "res://localization/ui.zh_CN.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.075, 0.12, 0.2, 1)

[audio]

driver/enable_input=false
