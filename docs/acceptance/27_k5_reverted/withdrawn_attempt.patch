index ca95665..2f1630d 100644
--- a/gameplay/inquiry_system.gd
+++ b/gameplay/inquiry_system.gd
@@ -85,6 +85,31 @@ func find_open(inquiry_id: String, game_state: Dictionary) -> Dictionary:
 func template_for(inquiry: Dictionary, data: Dictionary) -> Dictionary:
 	return data.get("inquiries", {}).get("items", {}).get(str(inquiry.get("template_id", "")), {})
 
+func offer_premium(inquiry: Dictionary, data: Dictionary) -> float:
+	var template := template_for(inquiry, data)
+	var customer: Dictionary = data.get("customers", {}).get("items", {}).get(str(template.get("customer_id", "")), {})
+	return float(template.get("premium", 1.0)) + (float(customer.get("counter_offer_premium_bonus", 0.0)) if bool(inquiry.get("countered", false)) else 0.0)
+
+func counter_offer(inquiry_id: String, game_state: Dictionary, data: Dictionary) -> Dictionary:
+	var inquiry := find_open(inquiry_id, game_state)
+	if inquiry.is_empty():
+		return {"ok": false, "reason": "inquiry_unavailable"}
+	if bool(inquiry.get("countered", false)):
+		return {"ok": true, "countered": true, "unchanged": true, "premium": offer_premium(inquiry, data)}
+	var customer_id := str(template_for(inquiry, data).get("customer_id", ""))
+	var customer: Dictionary = data.get("customers", {}).get("items", {}).get(customer_id, {})
+	var required_level := -1
+	var levels: Array = data.get("meta_progression", {}).get("relationships", {}).get("levels", [])
+	for index: int in range(levels.size()):
+		if str(levels[index].get("id", "")) == str(customer.get("counter_offer_level", "")):
+			required_level = index
+	if required_level >= 0 and int(Rules.relationship_level(customer_id, game_state, data).get("index", 0)) >= required_level:
+		inquiry["countered"] = true
+		return {"ok": true, "countered": true, "premium": offer_premium(inquiry, data)}
+	var declined := decline(inquiry_id, game_state, data)
+	declined["countered"] = false
+	return declined
+
 func evaluate(inquiry: Dictionary, datacenter: Dictionary, game_state: Dictionary, data: Dictionary) -> Dictionary:
 	var template := template_for(inquiry, data)
 	if template.is_empty() or datacenter.is_empty():
@@ -147,7 +172,9 @@ func accept(inquiry_id: String, datacenter: Dictionary, game_state: Dictionary,
 		return {"ok": false, "reason": "inquiry_requirements", "evaluation": evaluation}
 	if str(quote.get("inquiry_id", "")) != inquiry_id or str(quote.get("datacenter_id", "")) != str(datacenter.get("id", "")) or str(quote.get("template_id", "")) != str(inquiry.get("template_id", "")):
 		return {"ok": false, "reason": "inquiry_quote_stale"}
-	var premium := float(template.get("premium", 1.0))
+	var premium := offer_premium(inquiry, data)
+	if not is_equal_approx(float(quote.get("premium", -1.0)), premium):
+		return {"ok": false, "reason": "inquiry_quote_stale"}
 	var locked_rate := float(quote.get("locked_market_multiplier", 0.0))
 	var signed: Dictionary = sign_contract.call(str(datacenter.get("id", "")), str(template.get("customer_id", "")), str(template.get("duration_id", "standard")), premium, locked_rate, false)
 	if not bool(signed.get("ok", false)):
